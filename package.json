{
  "name": "agentic-browser",
  "version": "0.1.0",
  "description": "Embedded agentic browser for resilient, project-oriented web automation",
  "author": "shichao402",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "smoke:electron": "npm run build && electron . --smoke-test",
    "smoke:strategy-fault": "npm run build && electron . --strategy-fault-smoke-test",
    "smoke:strategy-workspace": "npm run build && electron . --strategy-workspace-smoke-test",
    "smoke:project-download": "npm run build && electron . --project-download-smoke-test",
    "smoke:project-download-recovery": "npm run build && node scripts/project-download-recovery-smoke.mjs",
    "smoke:project-download-fault": "npm run build && node scripts/project-download-fault-smoke.mjs",
    "smoke:project-download-renderer-recovery": "npm run build && node scripts/project-download-renderer-recovery-smoke.mjs",
    "smoke:project-concurrency": "npm run build && electron . --project-concurrency-smoke-test",
    "smoke:project-takeover": "npm run build && electron . --project-takeover-smoke-test",
    "smoke:automation-playground": "npm run build && electron . --automation-playground-smoke-test",
    "smoke:recovery": "npm run build && electron . --recovery-smoke-test",
    "smoke:watchdog": "npm run build && node scripts/watchdog-smoke.mjs",
    "smoke:watchdog:packaged": "npm run build && electron-builder --dir && node scripts/watchdog-smoke.mjs --packaged",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" \"scripts/**/*.mjs\" \"*.{json,js}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" \"scripts/**/*.mjs\" \"*.{json,js}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit:prod": "npm audit --omit=dev",
    "version:check": "node scripts/version-ssot.mjs check",
    "version:sync": "node scripts/version-ssot.mjs sync",
    "skill:ref": "node scripts/skill-ref.mjs print",
    "check": "npm run version:check && npm run channel:check && npm run format:check && npm run lint && npm run typecheck && npm run verify:api-docs && npm run test:coverage && npm run build && npm run audit:prod",
    "dist": "npm run version:check && npm run build && electron-builder --publish never",
    "dist:win": "npm run version:check && npm run build && electron-builder --win --x64 --publish never",
    "dist:mac": "npm run version:check && npm run build && electron-builder --mac --arm64 --x64 --publish never",
    "test:coverage": "vitest run --coverage",
    "channel:check": "node scripts/channel-check.mjs",
    "docs:api": "node scripts/api-docs/generate-api-reference.mjs",
    "verify:api-docs": "node scripts/api-docs/verify-api-docs.mjs",
    "dist:release": "node scripts/package-channel.mjs release",
    "dist:dev": "node scripts/package-channel.mjs dev",
    "deploy:release": "node scripts/deploy-channel.mjs release",
    "deploy:dev": "node scripts/deploy-channel.mjs dev"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.5.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "build": {
    "appId": "com.firoyang.agenticbrowser",
    "productName": "AgenticBrowser",
    "directories": {
      "output": "release/AgenticBrowser",
      "buildResources": "build"
    },
    "files": [
      "out/**",
      "package.json",
      "VERSION.json"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "${productName}-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "perMachine": false,
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "AgenticBrowser",
      "artifactName": "${productName}-${version}-win-${arch}.${ext}"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity",
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    }
  },
  "allowScripts": {
    "electron@44.7.2": true
  }
}
